# External project checkouts. Owned by their own repositories.
/projects/*
!/projects/.gitkeep
!/projects/README.md
!/projects/manifest.yaml

# Local agent / editor noise
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/
*.log
node_modules/

# Secrets and local env
.env
.env.*
!.env.example
*.pem
*.key
